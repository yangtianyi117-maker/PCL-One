<Grid x:Class="PCL.MyServerItem"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:local="clr-namespace:PCL"
      xmlns:svgIcon="clr-namespace:PCL.Core.UI.Controls.SvgIcon;assembly=PCL.Core.Wpf"
      Height="64" Margin="0,0,0,6"
      Background="{StaticResource ColorBrushSemiTransparent}"
      SnapsToDevicePixels="True" UseLayoutRounding="True"
      MouseEnter="Item_MouseEnter" MouseLeave="Item_MouseLeave" MouseLeftButtonUp="Item_Click" Cursor="Hand">
    <Grid.ColumnDefinitions>
        <ColumnDefinition Width="7" />
        <ColumnDefinition Width="50" />
        <ColumnDefinition Width="8" />
        <ColumnDefinition Width="1*" />
        <ColumnDefinition Width="Auto" />
    </Grid.ColumnDefinitions>
    <Grid.RowDefinitions>
        <RowDefinition Height="1*" />
        <RowDefinition Height="20" />
        <RowDefinition Height="18" />
        <RowDefinition Height="16" />
        <RowDefinition Height="1.1*" />
    </Grid.RowDefinitions>

    <!-- 图标 -->
    <Border Grid.Column="1" Grid.Row="1" Grid.RowSpan="3" Width="50" Height="50"
            HorizontalAlignment="Right" VerticalAlignment="Center" IsHitTestVisible="False">
        <Border.Clip>
            <RectangleGeometry Rect="0,0,50,50" RadiusX="6" RadiusY="6" />
        </Border.Clip>
        <local:MyImage x:Name="PathLogo" RenderOptions.BitmapScalingMode="HighQuality"
                       FallbackSource="pack://application:,,,/images/Icons/NoIcon.png" />
    </Border>

    <!-- 名称 + 副标题 -->
    <StackPanel Grid.Column="3" Grid.Row="1" Orientation="Horizontal" VerticalAlignment="Center"
                IsHitTestVisible="False">
        <TextBlock Text="{Binding Name}" FontSize="14" Foreground="{DynamicResource ColorBrush1}"
                   TextTrimming="WordEllipsis" />
        <TextBlock Text="{Binding SubTitle}" FontSize="12" Margin="6,0,0,0" VerticalAlignment="Center"
                   Foreground="{StaticResource ColorBrushGray1}" Opacity="0.5"
                   TextTrimming="WordEllipsis" />
    </StackPanel>

    <!-- 描述 -->
    <TextBlock Grid.Column="3" Grid.Row="2" VerticalAlignment="Center" Margin="0,0,10,0"
               Text="{Binding Description}" FontSize="12" TextTrimming="CharacterEllipsis"
               Foreground="{StaticResource ColorBrushGray3}" IsHitTestVisible="False" />

    <!-- 元信息：版本 / 人数 / 延迟 / 来源 -->
    <Grid Grid.Column="3" Grid.Row="3" VerticalAlignment="Center" IsHitTestVisible="False">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="24" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="24" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="24" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <svgIcon:SvgIcon Grid.Column="0" Icon="lucide/layout-list" Height="12" Stretch="Uniform"
                         IconBrush="{StaticResource ColorBrushGray4}" />
        <TextBlock Grid.Column="1" Text="{Binding VersionText}" Margin="4,0,0,0" FontSize="12"
                   Foreground="{StaticResource ColorBrushGray4}" />
        <svgIcon:SvgIcon Grid.Column="3" Icon="lucide/users" Height="12" Stretch="Uniform"
                         IconBrush="{StaticResource ColorBrushGray4}" />
        <TextBlock Grid.Column="4" Text="{Binding PlayersText}" Margin="4,0,0,0" FontSize="12"
                   Foreground="{StaticResource ColorBrushGray4}" />
        <svgIcon:SvgIcon Grid.Column="6" Icon="lucide/activity" Height="12" Stretch="Uniform"
                         IconBrush="{StaticResource ColorBrushGray4}" />
        <TextBlock Grid.Column="7" Text="{Binding LatencyText}" Margin="4,0,0,0" FontSize="12"
                   Foreground="{StaticResource ColorBrushGray4}" />
        <svgIcon:SvgIcon Grid.Column="9" Icon="lucide/globe" Height="12" Stretch="Uniform"
                         IconBrush="{StaticResource ColorBrushGray4}" />
        <TextBlock Grid.Column="10" Text="{Binding SourceText}" Margin="4,0,0,0" FontSize="12"
                   Foreground="{StaticResource ColorBrushGray4}" />
    </Grid>

    <!-- 右侧操作 -->
    <StackPanel x:Name="PanButtons" Grid.Column="4" Grid.RowSpan="5" Orientation="Horizontal"
                HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,8,0" Opacity="1">
        <local:MyButton x:Name="BtnJoin" Text="进入" Width="52" Height="26" ColorType="Highlight"
                        Margin="0,0,6,0" Click="BtnJoin_Click" />
        <local:MyIconButton x:Name="BtnCopy" Width="26" Height="26" SvgIcon="lucide/copy"
                            ToolTip="复制基岩版地址" Click="BtnCopy_Click" />
    </StackPanel>
</Grid>
